# Copy to .env and replace passwords. Do not commit .env.
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
REDIS_PASSWORD=replace-with-a-strong-cache-password
MONEF_TENANT=acme
MONEF_ADMIN_EMAIL=admin@example.com
MONEF_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PORT=8088
# IDEA 后端通过以下仅本机端口连接 Docker 数据库与 Redis。
MONEF_LOCAL_MYSQL_PORT=13306
MONEF_LOCAL_REDIS_PORT=16379
# Set true behind HTTPS. Compose publishes only to localhost by default.
COOKIE_SECURE=false
# For a disposable local demonstration only:
SEED_DEMO=false
FX_DEMO=false
# 最新换算默认使用匿名的 15 分钟延迟参考行情，并在界面注明来源。
FX_LIVE_PROVIDER=exchangerate_dev
# FX_LIVE_PROVIDER=frankfurter
# FX_LIVE_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=
# 所有用户共享的供应商调用预算，按实际套餐调整。
FX_REQUESTS_PER_MINUTE=7
# Optional OpenAI-compatible model via Spring AI:
AI_ENABLED=false
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini
